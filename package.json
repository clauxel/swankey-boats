{
  "name": "swankey-boats",
  "version": "1.0.0",
  "private": true,
  "description": "Swankey marketing site for the E498 electric jet bass boat (swankey.boats).",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "pages:build": "npm run build",
    "preview": "wrangler dev --config wrangler.worker.jsonc",
    "deploy": "node scripts/deploy.mjs",
    "start": "npm run preview",
    "lint": "eslint",
    "video": "node scripts/openrouter-video.mjs",
    "video:test": "node --test scripts/openrouter-video.test.mjs",
    "domain:test": "node --test worker/index.test.mjs",
    "verify:live": "node scripts/check-live.mjs",
    "indexnow": "node scripts/submit-indexnow.mjs"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4"
  }
}
