{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "swankey-boats",
  "compatibility_date": "2026-09-17",
  "workers_dev": true,
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/media/*"
    ]
  },
  "main": "worker/index.ts"
}
